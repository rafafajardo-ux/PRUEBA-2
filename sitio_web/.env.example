# Copie este archivo como .env y ajuste los valores. Ninguno es obligatorio para probar en local.

# Clave para firmar las sesiones. Si no se define, se genera una y se guarda en la carpeta de datos.
# SECRET_KEY=cambie-por-una-cadena-larga-y-aleatoria

# Carpeta donde viven la base de datos y los archivos subidos (por defecto ./instance). Haga copias de seguridad de ella.
# CARPETA_DATOS=/ruta/a/datos

# Administrador inicial: se crea en el primer arranque si aún no existe ninguno (alternativa a "flask --app wsgi crear-admin").
# ADMIN_USUARIO=rafael
# ADMIN_CLAVE=una-contrasena-larga

# Tamaño máximo de cada archivo subido, en MB (por defecto 100).
# MAX_MB=100

# En producción con HTTPS: cookies solo por https y confianza en las cabeceras del proxy (Nginx, Render, Railway...).
# COOKIE_SEGURA=1
# DETRAS_DE_PROXY=1

# Base de datos alternativa (por defecto SQLite dentro de CARPETA_DATOS). Ejemplo PostgreSQL (requiere psycopg):
# DATABASE_URL=postgresql+psycopg://usuario:clave@servidor/basedatos
